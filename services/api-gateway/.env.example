NODE_ENV=development
PORT=4000
SERVICE_NAME=api-gateway

# Downstream services
IDENTITY_SERVICE_URL=http://localhost:4001
BUSINESS_SERVICE_URL=http://localhost:4002
FULFILLMENT_SERVICE_URL=http://localhost:4003

# Must match the JWT_ACCESS_SECRET used by identity-service
JWT_ACCESS_SECRET=dev-access-secret-change-before-production-identity-service

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
