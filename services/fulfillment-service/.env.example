NODE_ENV=development
PORT=4003
SERVICE_NAME=fulfillment-service
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sparkin_fulfillment
JWT_ACCESS_SECRET=use-the-same-access-secret-as-identity-service

# Razorpay — payment gateway (optional, not active yet)
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development, live keys (rzp_live_...) for production
# NEVER commit real keys — keep them in .env only
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
